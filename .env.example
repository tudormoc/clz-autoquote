# MSSQL Configuration (Local Network)
MSSQL_USER=admin-user
MSSQL_PASSWORD=your-password
MSSQL_SERVER=192.168.1.XX
MSSQL_DATABASE_BUSINESS=COOPZANARDI
MSSQL_DATABASE_NETPRO=NETPRO
MSSQL_DATABASE_QUOTES=CLZDWHQANDPROG
MSSQL_DATABASE_DATAWAREHOUSE=DWHZANARDI
# For local dev without SSL certificates
MSSQL_TRUST_CERT=true

# Login. AUTH_SECRET: a long random text, the SAME on every machine that uses these databases (it scrambles the
# users' PINs and signs the logins). Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# The superadmin (no restrictions, manages users and groups); not stored in the database
SUPERADMIN_NAME=superadmin
SUPERADMIN_PIN=
