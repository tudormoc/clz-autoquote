{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/lint-edited.js\"",
            "shell": "bash",
            "timeout": 60,
            "asyncRewake": true,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ]
  }
}
